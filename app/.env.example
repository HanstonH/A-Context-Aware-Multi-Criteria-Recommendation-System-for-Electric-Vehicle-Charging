# Copy to app/.env and restart `npx expo start` after changing it.
# Backend address: your Railway URL, or http://<your PC's LAN IP>:8000 when running `python -m backend` locally.
# Leave empty to run the app in offline mode (on-phone chatbot and distance ranking).
EXPO_PUBLIC_API_URL=
# Only if the backend has APP_API_KEY set.
EXPO_PUBLIC_API_KEY=
