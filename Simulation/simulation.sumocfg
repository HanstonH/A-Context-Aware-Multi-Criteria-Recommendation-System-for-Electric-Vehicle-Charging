<configuration>
    <input>
        <net-file value="taipei.net.xml"/>
        <route-files value="taipei.rou.xml"/>
        <additional-files value="my_config.additional.xml,charging_stations.add.xml"/>
    </input>

    <output>
        <battery-output value="output/battery_log.xml"/>
        <battery-output.precision value="2"/>
        <tripinfo-output value="output/tripinfo.xml"/>
        <summary-output value="output/summary.xml"/>
        <statistic-output value="output/statistics.xml"/>
    </output>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
    </processing>
</configuration>