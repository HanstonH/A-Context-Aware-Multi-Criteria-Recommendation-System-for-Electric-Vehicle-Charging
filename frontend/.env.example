# Supabase（前端公開 anon key；後端請改用 SUPABASE_URL + SUPABASE_SERVICE_KEY）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps（Maps JavaScript API；對應後端的 GOOGLE_MAPS_API_KEY）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Gemini AI（僅伺服器端，勿加 NEXT_PUBLIC_）
GEMINI_API_KEY=your_gemini_key

# Express 充電站 API（伺服器端轉發）
# EXPRESS_BACKEND_URL 為統一名稱；EXPRESS_API_URL 為相容別名，兩者擇一即可
EXPRESS_BACKEND_URL=http://localhost:5000
EXPRESS_API_URL=http://localhost:5000
# 選用：若路徑不是 /api/stations，請指定實際 GET 路徑
# EXPRESS_STATIONS_PATH=/api/stations

# FastAPI AI 推薦（伺服器端轉發）
FASTAPI_URL=http://127.0.0.1:8000
# 選用：若路徑不是 /recommend，請指定實際 POST 路徑
# FASTAPI_RECOMMEND_PATH=/recommend

# 選用：Google Map ID（啟用客製化 Advanced Marker 圖標）
# NEXT_PUBLIC_GOOGLE_MAP_ID=your-map-id
