# Copy to backend/.env for local runs. On Railway, set these under the service's Variables.

# Required for /api/chat and /api/explain (Gemini free tier is fine).
GEMINI_API_KEY=

# Optional. Models tried in order; the next is used when one is busy or out of quota.
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite

# Optional voice settings (/api/voice). The voice is one of Gemini's 30 prebuilt voices.
# GEMINI_TTS_VOICE=Kore
# GEMINI_STT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# GEMINI_VOICE_THINKING=low
# VOICE_MAX_UPLOAD_MB=4

# Optional shared key. If set, put the same value in app/.env as EXPO_PUBLIC_API_KEY.
# APP_API_KEY=

# Optional limits, per IP per minute.
# RATE_LIMIT_AI_PER_MIN=8
# RATE_LIMIT_PER_MIN=60

# Optional ranking weights (POI is not used; defaults are 1/3 each).
# WEIGHT_DISTANCE=0.3333
# WEIGHT_WAIT=0.3333
# WEIGHT_COST=0.3333

# Placeholder waiting time in minutes until the wait model is finished.
# WAIT_PLACEHOLDER_MIN=0
